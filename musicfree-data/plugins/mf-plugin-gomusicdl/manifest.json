{
  "name": "mf-plugin-gomusicdl",
  "title": "GoMusicDL",
  "version": "0.1.5",
  "author": "tinynas",
  "repo": "https://github.com/guohuiyuan/go-music-dl",
  "icon": "https://cdn.jsdelivr.net/gh/guohuiyuan/go-music-dl@main/docs/logo.png",
  "type": "scraper",
  "description": "Remote search and download plugin powered by go-music-dl",
  "entry": {
    "wasmPath": "plugin.wasm",
    "exportedFunctions": {
      "scraperSong": "ScraperSong",
      "getCover": "GetCover",
      "remoteSearch": "RemoteSearch",
      "remoteDownload": "RemoteDownload",
      "fetchPlaylist": "FetchPlaylist",
      "getLyrics": "GetLyrics",
      "getAlbumInfo": "GetAlbumInfo"
    }
  },
  "config": {
    "fields": {
      "download_dir": {
        "type": "string",
        "required": false,
        "description": "Optional target directory for downloaded files"
      },
      "kugou_cookie": {
        "type": "string",
        "required": false,
        "secret": true,
        "description": "酷狗 Cookie（登录 kugou.com 后从浏览器复制）。下载酷狗音源必填。"
      },
      "qq_cookie": {
        "type": "string",
        "required": false,
        "secret": true,
        "description": "QQ 音乐 Cookie，下载 QQ 音源时可能需要"
      },
      "netease_cookie": {
        "type": "string",
        "required": false,
        "secret": true,
        "description": "网易云音乐 Cookie，下载网易云音源时可能需要"
      },
      "kuwo_cookie": {
        "type": "string",
        "required": false,
        "secret": true,
        "description": "酷我 Cookie（可选）"
      },
      "migu_cookie": {
        "type": "string",
        "required": false,
        "secret": true,
        "description": "咪咕 Cookie（可选）"
      }
    }
  }
}
